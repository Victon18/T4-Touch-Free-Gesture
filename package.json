{
  "name": "gesture",
  "private": true,
  "scripts": {
    "ai-dev": "FLASK_DEBUG=1 pip3 install -r requirements.txt && python3 -m flask --app apps/web/ai/index run -p 5328",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/extension-accelerate": "^3.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.8",
    "prisma": "^7.4.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  }
